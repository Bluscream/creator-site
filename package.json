{
	"name": "creator-site",
	"version": "0.0.0",
	"private": false,
	"license": "AGPL-3.0-or-later",
	"description": "A self-hosted website for content creators: links, live chat, a merged post feed, a subscribable event calendar and an admin to run it all.",
	"keywords": [
		"creator",
		"linktree",
		"streaming",
		"chat",
		"feed",
		"calendar",
		"self-hosted",
		"sveltekit"
	],
	"author": "Bluscream",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Bluscream/creator-site.git"
	},
	"homepage": "https://github.com/Bluscream/creator-site#readme",
	"bugs": "https://github.com/Bluscream/creator-site/issues",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run format:check && npm run lint:code",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"sync": "svelte-kit sync",
		"gate": "npm run sync && npm run format:check && npm run lint:code && npm audit --audit-level=moderate && npm run build && npm run check && npm run test:unit -- --run",
		"format:check": "prettier --check .",
		"lint:code": "eslint .",
		"scan:secrets": "node scripts/scan-secrets.js"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"prettier --write",
			"eslint --fix --max-warnings 0"
		],
		"*.{json,md,css,html,yml,yaml}": [
			"prettier --write"
		]
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.2",
		"better-sse": "^0.16.1",
		"culori": "^4.0.2",
		"lucide": "^1.52.0",
		"pino": "^10.4.0",
		"proper-lockfile": "^4.1.2",
		"read-last-lines": "^1.10.0",
		"rotating-file-stream": "^3.2.10",
		"simple-icons": "^16.34.0",
		"synchra-ts": "^0.1.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.26.0",
		"@playwright/test": "^1.63.0",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.6.4",
		"@types/proper-lockfile": "^4.1.4",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"playwright": "^1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"secretlint": "^13.0.7",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"overrides": {
		"esbuild": "^0.28.0"
	}
}
