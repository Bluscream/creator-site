# creator-site configuration.
#
# Copy to `.env` and fill in what you have. **Only DATABASE_URL is required** — everything else is
# an integration, and an absent integration is a supported state rather than a failure: the site
# renders, and the parts that need the missing credential report themselves unavailable instead of
# taking the page down. An install with nothing but the first setting below works.
#
# `.env` is gitignored and must stay that way. It is read only by the server; nothing here reaches a
# browser, because `$app/env/private` is a module the bundler refuses to ship to one.
#
# Everything a *creator* configures — their links, their name, their theme — belongs in the admin,
# not in this file. This is for secrets and deployment facts only.
#
# The authoritative list is `src/env.ts`, where each variable is declared with its validation. If
# the two ever disagree, that file is right and this one is stale.


# --- Required -------------------------------------------------------------------------------------

# Where SQLite keeps its file: a path, relative to the working directory or absolute.
DATABASE_URL=data/creator-site.db


# --- Storage and logging --------------------------------------------------------------------------

# Where the database, the log, the cache and the configuration documents live. Never web-reachable.
# The documents a creator edits are in `<DATA_DIR>/config/`, one JSON file per area — so backing up
# this directory backs up both the data and the configuration. Default: data
# DATA_DIR=data

# trace | debug | info | warn | error | fatal. Default: info
# LOG_LEVEL=info


# --- Synchra --------------------------------------------------------------------------------------
#
# Issue a token at https://dash.synchra.net. The site only ever reads, so grant the narrowest scope
# set that works.
#
# Live status and chat are read **anonymously** and need only the channel id, so a deployment that
# sets SYNCHRA_CHANNEL_ID and no token still shows both. The token is what the activity feed
# (donations, subs, gifts) needs, and what the event gateway that pushes updates instead of polling
# authenticates with.

# SYNCHRA_CHANNEL_ID=
# SYNCHRA_TOKEN=

# The watch page the chat and live pages embed.
# SYNCHRA_WATCH_URL=


# --- Discord --------------------------------------------------------------------------------------
#
# Signing in to the admin. Create an application at https://discord.com/developers/applications.
# Without these the admin refuses to run, which is the right failure for an unconfigured install.

# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# The OAuth2 redirect is normally built from the request, because the site answers on several
# hostnames and each needs its own registered redirect. Set this only to pin it.
# DISCORD_REDIRECT_URI=

# Comma-separated Discord **user ids** — not usernames, which their owner can change and somebody
# else can then take. Anything that is not a 17–20 digit id is ignored. Empty means nobody gets in.
# ADMIN_DISCORD_IDS=


# --- Twitch ---------------------------------------------------------------------------------------
#
# For the VOD and clip feed. A client-credentials grant: no user sign-in, no redirect, no refresh
# token. Register at https://dev.twitch.tv/console/apps.

# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
